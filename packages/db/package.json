{
  "name": "@euclid/db",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrator.ts up",
    "migrate:down": "tsx src/migrator.ts down",
    "migrate:latest": "tsx src/migrator.ts latest"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "kysely": "^0.29.8",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@euclid/tsconfig": "workspace:*",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
