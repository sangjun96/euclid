LANGFUSE_SECRET_KEY=sk-lf-mock
LANGFUSE_NEXTAUTH_SECRET=dev-secret-minimum-32-characters-required-here!
LANGFUSE_SALT=dev-salt-minimum-32-characters-required-here!

# API Server Port
PORT=4000
