# Replace both values with long random alphanumeric secrets before starting.
POSTGRES_PASSWORD=replacewithlongrandomalphanumericpassword
PHOENIX_SECRET=replacewithlongrandomalphanumericsecret
WEB_PORT=8080
PHOENIX_PORT=6006
PHOENIX_VERSION=version-20.1.0
# Expose via an authenticated TLS reverse proxy; default bindings are loopback only.
WEB_BIND=127.0.0.1
PHOENIX_BIND=127.0.0.1
# After initializing Phoenix, set a Phoenix API key and restart API and worker.
PHOENIX_API_KEY=
